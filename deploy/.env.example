# Пример env для docker compose (deploy/.env). Скопировать в .env и заполнить.
# .env НЕ коммитить (проверь, что он в .gitignore).

# --- remark42 ---
# Публичный адрес remark42, каким его видит браузер (за nginx сайта, path /remark42)
REMARK_URL=https://firebirdsql.su/remark42
# Секрет для подписи (сгенерировать: openssl rand -hex 32)
SECRET=
# Админ: список имён/ID через запятую
ADMIN_SHARED_ID=
# Timezone
TZ=Europe/Moscow

# --- Telegram-авторизация ---
# Токен бота от @BotFather
AUTH_TELEGRAM_TOKEN=

# --- Яндекс-авторизация ---
AUTH_YANDEX_CID=
AUTH_YANDEX_CSECRET=

# --- Google-авторизация ---
# OAuth-клиент Google Cloud Console; без верификации приложения Google
# показывает «непроверенное приложение» (терпимо для старта, ADR-0006)
AUTH_GOOGLE_CID=
AUTH_GOOGLE_CSECRET=

# --- Слот ИИ-сервиса (ADR-0007, на будущее) ---
# AI_API_KEY=
