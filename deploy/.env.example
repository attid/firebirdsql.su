# Опциональный локальный файл для docker compose (compose подставит ${...}).
# На сервере .env НЕ используется (запрещены политикой): в Portainer те же
# переменные задаются в UI стека (раздел Environment).
# Этот файл — шаблон: скопировать в deploy/.env только локально, не коммитить.

# --- remark42, обязательные ---
# Публичный адрес remark42, каким его видит браузер (за nginx сайта, path /remark42)
REMARK_URL=https://firebirdsql.su/remark42
# Секрет для подписи (сгенерировать: openssl rand -hex 32)
SECRET=
# Админ: список имён/ID через запятую
ADMIN_SHARED_ID=

# --- Telegram-авторизация: токен бота от @BotFather ---
AUTH_TELEGRAM_TOKEN=

# --- Яндекс-авторизация ---
AUTH_YANDEX_CID=
AUTH_YANDEX_CSECRET=

# --- Google-авторизация ---
# OAuth-клиент Google Cloud Console; без верификации приложения Google
# показывает «непроверенное приложение» (терпимо для старта, ADR-0006)
AUTH_GOOGLE_CID=
AUTH_GOOGLE_CSECRET=

# --- Прочее ---
TZ=Europe/Moscow

# --- Слот ИИ-сервиса (ADR-0007, на будущее) ---
# AI_API_KEY=
