# Опциональный локальный файл для docker compose (compose подставит ${...}).
# На сервере .env НЕ используется (запрещены политикой): в Portainer те же
# переменные задаются в UI стека (раздел Environment).
# Этот файл — шаблон: скопировать в deploy/.env только локально, не коммитить.
#
# Имена переменных сверены с https://remark42.com/docs/configuration/parameters/
# Префикс REMARK_ непоследователен: REMARK_URL существует, REMARK_SITE — НЕТ
# (site id задаётся переменной SITE). Яндекс/Google включаются фактом
# наличия CID/CSEC — отдельных флагов включения у них нет.

# --- remark42, обязательные ---
# Публичный адрес remark42, каким его видит браузер (за nginx сайта, path /remark42)
REMARK_URL=https://firebirdsql.su/remark42
# Секрет для подписи (сгенерировать: openssl rand -hex 32)
SECRET=
# Site ID (должен совпадать с site_id виджета на страницах сайта)
SITE=firebirdsql
# Админ: список имён/ID через запятую
ADMIN_SHARED_ID=

# --- Telegram-авторизация: токен бота от @BotFather ---
TELEGRAM_TOKEN=

# --- Яндекс-авторизация (заполнение ключей включает провайдер) ---
AUTH_YANDEX_CID=
AUTH_YANDEX_CSEC=

# --- Google-авторизация (заполнение ключей включает провайдер) ---
# OAuth-клиент Google Cloud Console; без верификации приложения Google
# показывает «непроверенное приложение» (терпимо для старта, ADR-0006)
AUTH_GOOGLE_CID=
AUTH_GOOGLE_CSEC=

# --- Прочее ---
# Часовой пояс: образ remark42 читает TIME_ZONE (TZ он игнорирует)
TIME_ZONE=Europe/Moscow

# --- Уведомления админу (по умолчанию remark42 их НЕ шлёт) ---
# NOTIFY_ADMINS=telegram + ID канала: создай приватный канал, добавь бота
# его админом, ID канала (отрицательный, -100...) возьми из
# https://api.telegram.org/bot<ТОКЕН>/getUpdates после сообщения в канал
NOTIFY_ADMINS=telegram
NOTIFY_TELEGRAM_CHAN=
# NOTIFY_USERS=telegram — ответы комментаторам в личку (по желанию)

# --- Слот ИИ-сервиса (ADR-0007, на будущее) ---
# AI_API_KEY=
