---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const sectionTitles: Record<string, string> = {
  glossary: "Глоссарий",
  intro: "Введение",
  install: "Установка и настройка",
  errors: "Обработка ошибок",
  sql: "SQL-рецепты",
  groups: "Тематические группы",
};
const sectionTitle = sectionTitles[entry.data.section] ?? entry.data.section;
const toc = headings.filter((h) => h.depth <= 3);
---

<BaseLayout title={entry.data.title}>
  <div class="breadcrumbs">
    <a href="/">Главная</a> / <a href="/glossarij/">Справочник</a> / {sectionTitle}
  </div>
  <article class="doc-content" data-pagefind-body>
    {toc.length > 2 && (
      <nav class="toc" aria-label="Содержание">
        <strong>Содержание</strong>
        <ul>
          {toc.map((h) => (
            <li style={`margin-left:${(h.depth - 2) * 1}rem`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <Content />
  </article>
</BaseLayout>

<style>
  .toc {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1.25rem;
    margin: 0.5rem 0 1.5rem;
    font-size: 0.9rem;
  }
  .toc ul { margin: 0.4rem 0 0; padding-left: 1rem; }
</style>
