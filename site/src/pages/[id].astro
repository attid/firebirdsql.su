---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const sectionTitles: Record<string, string> = {
  glossary: "Глоссарий",
  intro: "Введение",
  install: "Установка и настройка",
  errors: "Обработка ошибок",
  sql: "SQL-рецепты",
  groups: "Тематические группы",
};
const sectionTitle = sectionTitles[entry.data.section] ?? entry.data.section;
const toc = headings.filter((h) => h.depth <= 3);

// Мета-описание из первого содержательного абзаца тела: механически,
// без редактуры (ADR-0004). Практически у всех страниц глоссария это
// раздел «Описание» либо вводный абзац.
function metaDescription(body: string): string {
  const clean = body
    .split("\n")
    .filter((ln) => !/^\s*(#|\||```|\x00)/.test(ln)) // без заголовков/таблиц/кода
    .join(" ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1") // ссылки -> текст
    .replace(/[*_`<>]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  const cut = clean.slice(0, 160);
  const dot = cut.lastIndexOf(".");
  const out = (dot > 80 ? cut.slice(0, dot + 1) : cut).trim();
  return out.length < 40 ? `${entry.data.title} — ${sectionTitle} справочника по Firebird` : out;
}
const description = metaDescription(entry.body ?? "");
---

<BaseLayout title={entry.data.title} description={description}>
  <div class="breadcrumbs">
    <a href="/">Главная</a> / <a href="/glossarij/">Справочник</a> / {sectionTitle}
  </div>
  <article class="doc-content" data-pagefind-body>
    {toc.length > 2 && (
      <nav class="toc" aria-label="Содержание">
        <strong>Содержание</strong>
        <ul>
          {toc.map((h) => (
            <li style={`margin-left:${(h.depth - 2) * 1}rem`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <Content />

    <section class="comments" aria-label="Комментарии">
      <h2>Обсуждение</h2>
      <div id="remark42"></div>
    </section>
  </article>
</BaseLayout>

<style>
  .toc {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1.25rem;
    margin: 0.5rem 0 1.5rem;
    font-size: 0.9rem;
  }
  .toc ul { margin: 0.4rem 0 0; padding-left: 1rem; }
  .comments { margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 1rem; }
</style>

<script>
  // Виджет remark42 (ADR-0006). Живёт за тем же nginx: /remark42/ -> контейнер.
  // Локально в dev контейнера нет — скрипт тихо не грузится, секция остаётся пустой.
  var remark_config = {
    host: "/remark42",
    site_id: "firebirdsql",
    components: ["embed"],
    locale: "ru",
  };
  (function (c) {
    for (var i = 0; i < c.length; i++) {
      var d = document.createElement("script");
      const name = c[i] === "embed" ? "web" : c[i];
      d.src = "/remark42/" + name + ".js";
      d.defer = true;
      (document.head || document.body).appendChild(d);
    }
  })(remark_config.components);
</script>
