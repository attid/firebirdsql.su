---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const siteName = "Словарик по FireBird";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const desc =
  description ?? "Русскоязычный справочник по СУБД Firebird: глоссарий SQL-конструкций, встроенные функции, системные таблицы, статьи и рецепты.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Тема до первой отрисовки — без мигания. Порядок: сохранённый выбор,
      // затем системная prefers-color-scheme.
      (function () {
        var t = localStorage.getItem("theme");
        if (t !== "light" && t !== "dark") {
          t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><span class="flame">🔥</span> Словарик по FireBird</a>
      <nav>
        <a href="/glossarij/">Глоссарий</a>
        <a href="/search/">Поиск</a>
        <a href="/novosti/">Новости</a>
        <a href="/download/">Скачать</a>
        <a href="/novoe/">Что нового</a>
        <a href="/o_sajte/">О сайте</a>
      </nav>
      <select class="fb-version-select" aria-label="Ваша версия Firebird">
        <option value="">версия: любая</option>
        <option value="2.5">Firebird 2.5</option>
        <option value="3.0">Firebird 3.0</option>
        <option value="4.0">Firebird 4.0</option>
        <option value="5.0">Firebird 5.0</option>
        <option value="6.0">Firebird 6.0</option>
      </select>
      <button class="theme-toggle" aria-label="Переключить тему">
        <span class="theme-icon">◐</span>
      </button>
    </header>
    <main class="page">
      <slot />
      <footer class="page-footer">
        <p>
          Содержимое — по лицензии
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ru">CC BY-NC-SA 4.0</a>.
          <a href="/istochniki_i_avtory/">Источники и авторы</a>.
        </p>
      </footer>
    </main>
    <script>
      // Переключатель темы + кнопки копирования код-блоков
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
      document.querySelectorAll("pre.astro-code").forEach((pre) => {
        const btn = document.createElement("button");
        btn.className = "copy-btn";
        btn.textContent = "копировать";
        btn.addEventListener("click", async () => {
          await navigator.clipboard.writeText(pre.innerText);
          btn.textContent = "скопировано";
          setTimeout(() => (btn.textContent = "копировать"), 1500);
        });
        pre.appendChild(btn);
      });

      // --- «Моя версия» (ADR-0005): селектор в шапке + баннер совместимости ---
      const vcmp = (a, b) => {
        const pa = a.split(".").map(Number), pb = b.split(".").map(Number);
        for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
          const d = (pa[i] || 0) - (pb[i] || 0);
          if (d) return Math.sign(d);
        }
        return 0;
      };
      const select = document.querySelector(".fb-version-select");
      select.value = localStorage.getItem("fb-version") || "";
      const hint = document.querySelector(".fb-user-version");
      const applyVersion = () => {
        const v = select.value;
        if (hint) hint.textContent = v || "любая";
        const meta = document.querySelector(".fb-meta");
        const old = document.querySelector(".fb-banner");
        if (old) old.remove();
        if (!meta || !v) return;
        const since = meta.dataset.since, until = meta.dataset.until;
        let msg = null;
        if (since && vcmp(since, v) > 0) msg = `эта конструкция появилась в Firebird ${since} — в вашей версии ${v} её ещё нет`;
        else if (until && vcmp(until, v) < 0) msg = `в вашей версии ${v} этой конструкции уже нет (работала до Firebird ${until})`;
        if (msg && !meta.dataset.deprecated) {
          const b = document.createElement("div");
          b.className = "fb-banner";
          b.textContent = `⚠ Ваша версия: Firebird ${v}. ${msg}.`;
          meta.after(b);
        }
      };
      select.addEventListener("change", () => {
        localStorage.setItem("fb-version", select.value);
        applyVersion();
      });
      applyVersion();
    </script>
  </body>
</html>
